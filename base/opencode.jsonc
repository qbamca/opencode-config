{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 1,
  "lsp": true,
  "permission": {
    "lsp": "allow"
  },
  "default_agent": "build",
  "compaction": {
    "auto": false
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "plugin": [
    "@zenobius/opencode-skillful",
    "opencode-openai-codex-auth",
    "opencode-browser",
    "@mohak34/opencode-notifier@latest",
    "opencode-acp@stable"
  ],
  "mcp": {
    "Figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "{file:/home/qbamca/.config/opencode/secrets/github-authorization}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{file:/home/qbamca/.config/opencode/secrets/context7-api-key}"
      }
    },
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  }
}
